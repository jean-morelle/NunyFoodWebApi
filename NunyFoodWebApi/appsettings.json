{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=NunyFoodDb;Username=postgres;"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "NunyFoodApi",
    "Audience": "NunyFoodClient",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nunyfood-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Gmail": {
    "FromEmail": "koudorojeanmorelle46@gmail.com",
    "AppPassword": "",
    "DisplayName": "NunyFood"
  },
  "RateLimiting": {
    "AuthPermitLimit": 20,
    "AuthWindowSeconds": 60,
    "OtpEmailPermitLimit": 5,
    "OtpEmailWindowSeconds": 900
  },
  "AllowedHosts": "*"
}
