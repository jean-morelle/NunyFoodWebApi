{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=NunyFoodDb;Username=postgres;Password=CHANGE_ME"
  },
  "Jwt": {
    "Secret": "NunyFoodWebApi-SuperSecretKey-ChangeMe-AtLeast32Chars!",
    "Issuer": "NunyFoodApi",
    "Audience": "NunyFoodClient",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/nunyfood-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
